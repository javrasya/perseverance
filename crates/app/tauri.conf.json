{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "perseverance",
  "version": "0.1.0",
  "identifier": "dev.perseverance.app",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [
      {
        "title": "perseverance",
        "width": 1280,
        "height": 800,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
